# Plantilla de /home/johan/My_Bookshelf/.env
#
# El .env real NO se versiona nunca: lleva claves de API y el SECRET_KEY. Va en
# la copia de seguridad cifrada, no en git.
# Copiar como .env y rellenar. Sin estas variables el sitio no arranca.

# --- Django ---
DJANGO_SECRET_KEY=
# OJO: en el .env de producción esta clave quedó escrita con un espacio final
# ("DEBUG ="), así que os.getenv('DEBUG') devuelve None y DEBUG acaba en False.
# Sale bien por casualidad, pero si algún día hace falta activarlo de verdad hay
# que corregir el nombre.
DEBUG=False

# --- Base de datos ---
# USE_LOCAL_DATABASE=true usa el SQLite database.db (que es lo de producción).
# Con false, se usa DATABASE_URL (Postgres/Supabase).
USE_LOCAL_DATABASE=true
DATABASE_URL=

# --- Embeddings (Gemini) ---
# Cambiar GEMINI_EMBEDDING_MODEL invalida las etiquetas del modelo de interés:
# hay que pasar después `python manage.py reembed_interest_labels`.
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# --- Qdrant (servicio local, ver deploy/qdrant.service) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=news_embeddings_gemini001_d768_v1

# --- Resúmenes de noticias ---
CEREBRAS_API_KEY=
# Groq quedó como proveedor heredado; el modelo activo se elige en el admin.
GROQ_API_KEY=
GROQ_MODEL=

# --- Mi TV ---
# Trakt está retirado (da 403 y exige VIP); la fuente activa es Simkl.
# El token de Simkl dura ~5 años y no tiene refresh: si muere,
# `python manage.py simkl_auth` imprime un PIN para https://simkl.com/pin
TRAKT_CLIENT_ID=
TRAKT_USERNAME=
TMDB_API_KEY=
SIMKL_CLIENT_ID=
SIMKL_ACCESS_TOKEN=

# --- Opcional ---
# Ruta del log del cron. Por defecto, BASE_DIR/../log_cron_bookshelf.txt
CRON_LOG_PATH=
