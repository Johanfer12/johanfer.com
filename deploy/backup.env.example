# Plantilla de /etc/johanfer-backup.env (root:root, modo 600).
# El real no se versiona: dice dónde están las copias y dónde sus credenciales.
# Lo lee deploy/bin/johanfer-backup-lib, que cargan todos los scripts de copia.
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
RESTIC_REPOSITORY=rclone:<remoto>:<ruta-del-repositorio>
RESTIC_PASSWORD_FILE=/root/.config/restic/<fichero-de-contraseña>
# Carpeta de rclone donde van las copias (un archivo por copia, en huecos fijos).
BACKUP_REMOTE=<remoto>:<ruta>/archivos
# RESTIC_REPOSITORY y RESTIC_PASSWORD_FILE: el repositorio viejo de restic (ya
# no se escribe) y la contraseña, que sigue cifrando las copias nuevas con gpg.
