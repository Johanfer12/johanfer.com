# Plantilla de /etc/johanfer-backup.env (root:root, modo 600).
# El real no se versiona: dice dónde están las copias y dónde sus credenciales.
# Lo leen deploy/bin/johanfer-db-backup y deploy/bin/johanfer-qdrant-backup.
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
RESTIC_REPOSITORY=rclone:<remoto>:<ruta-del-repositorio>
RESTIC_PASSWORD_FILE=/root/.config/restic/<fichero-de-contraseña>
