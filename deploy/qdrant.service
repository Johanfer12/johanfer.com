# Base de datos vectorial. Guarda los embeddings de las noticias, que son la
# base de la detección de duplicados.
#
# Instalar en /etc/systemd/system/qdrant.service
#
# Binario: /opt/qdrant/qdrant (v1.15.4, descargado de los releases de GitHub,
# NO viene por apt). Escucha SOLO en 127.0.0.1: no debe quedar expuesto.
#
#   sudo mkdir -p /opt/qdrant /var/lib/qdrant/storage
#   sudo curl -L -o /opt/qdrant/qdrant \
#     https://github.com/qdrant/qdrant/releases/download/v1.15.4/qdrant-aarch64-unknown-linux-musl
#   sudo chmod +x /opt/qdrant/qdrant
#   sudo chown -R johan:johan /var/lib/qdrant
#   sudo systemctl enable --now qdrant
#
# El storage (/var/lib/qdrant/storage, ~52 MB) son DATOS, no configuración, y
# desde septiembre de 2026 son datos IRRECUPERABLES: con la ventana de
# duplicados en un año, las noticias se purgan a los 15 días y sus vectores
# siguen vivos, así que `manage.py qdrant_backfill` ya solo puede regenerar
# los recientes —los que aún tienen su noticia en la base—, no el resto.
#
# Lo respalda `johanfer-qdrant-backup` (ver deploy/bin/ y deploy/systemd/),
# que hace un snapshot por la API y lo sube al mismo restic que la base.
# Hasta esa fecha este comentario decía que el storage "entra en la copia de
# seguridad" y era falso: solo se respaldaba database.db.

[Unit]
Description=Qdrant Vector DB
After=network-online.target
Wants=network-online.target

[Service]
User=johan
Group=johan
Environment=QDRANT__STORAGE__STORAGE_PATH=/var/lib/qdrant/storage
Environment=QDRANT__SERVICE__HOST=127.0.0.1
Environment=QDRANT__SERVICE__HTTP_PORT=6333
WorkingDirectory=/var/lib/qdrant
ExecStart=/opt/qdrant/qdrant
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
