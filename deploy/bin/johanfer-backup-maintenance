#!/bin/bash
# Retención y verificación completa del repositorio de restic, una vez a la
# semana. Instalar en /usr/local/sbin/johanfer-backup-maintenance.
#
# `forget --prune` toma un cerrojo exclusivo del repositorio: mientras corre,
# los demás backups fallarían. Por eso va el domingo de madrugada, lejos de
# ellos, y la copia de configuración va el sábado.
set -Eeuo pipefail
umask 077
set -a; . /etc/johanfer-backup.env; set +a
export RESTIC_CACHE_DIR=/var/cache/johanfer-restic

/usr/bin/restic forget --host raspberrypi --tag johanfer-database --keep-within 2d --keep-daily 14 --keep-weekly 8 --keep-monthly 12 --prune
/usr/bin/restic forget --host raspberrypi --tag johanfer-qdrant --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune
/usr/bin/restic forget --host raspberrypi --tag johanfer-config --keep-weekly 8 --keep-monthly 12 --prune
/usr/bin/restic check --read-data
