#!/bin/bash
# Copia cifrada de la base SQLite. Instalar en /usr/local/sbin/johanfer-db-backup.
# Corre cuatro veces al día (johanfer-db-backup.timer). Formato y restauración:
# ver johanfer-backup-lib.
#
# Huecos (la misma retención que tenía restic: 2 días enteros, 14 diarias,
# 8 semanales y 12 mensuales, 42 ficheros de ~2 MB):
#   base-6h-0..7       cada pasada; 4 al día × 2 días
#   base-dia-00..13    la primera pasada de cada día
#   base-semana-0..7   la primera de cada semana
#   base-mes-01..12    la primera de cada mes
# «Primera» se decide mirando la fecha de lo que ocupa el hueco en el remoto,
# así que una pasada perdida (Pi apagada) no deja un hueco sin renovar.
set -Eeuo pipefail
umask 077
. /usr/local/sbin/johanfer-backup-lib
trap terminar_gpg EXIT

SOURCE_DB=/home/johan/My_Bookshelf/database.db
COPIA="$WORK_DIR/database.db"
CIFRADA="$WORK_DIR/base.db.zst.gpg"

# sqlite3.backup() y no cp: con la base en WAL, cp daría una copia inconsistente.
/usr/bin/python3 - "$SOURCE_DB" "$COPIA" <<'PY'
import sqlite3
import sys

source_path, destination_path = sys.argv[1:]
source = sqlite3.connect(f"file:{source_path}?mode=ro", uri=True, timeout=60)
destination = sqlite3.connect(destination_path)
try:
    source.backup(destination, pages=256, sleep=0.05)
    result = destination.execute("PRAGMA integrity_check").fetchone()
    if result != ("ok",):
        raise RuntimeError(f"SQLite integrity_check failed: {result!r}")
finally:
    destination.close()
    source.close()
PY

NIVEL_ZSTD=19 cifrar "$COPIA" "$CIFRADA"
rm -f "$COPIA"

HORA=$(date -u +%H); HORA=${HORA#0}
subir "$CIFRADA" "base/base-6h-$(( (DIA % 2) * 4 + HORA / 6 )).db.zst.gpg"

HOY=$(date -u +%F)
dia="base/base-dia-$(printf %02d $(( DIA % 14 ))).db.zst.gpg"
[ "$(fecha_remota "$dia")" = "$HOY" ] || subir "$CIFRADA" "$dia"

semana="base/base-semana-$(( SEMANA % 8 )).db.zst.gpg"
f=$(fecha_remota "$semana")
if [ -z "$f" ] || [ $(( $(date -u -d "$f" +%s) / 86400 / 7 )) -ne "$SEMANA" ]; then
  subir "$CIFRADA" "$semana"
fi

mes="base/base-mes-$(date -u +%m).db.zst.gpg"
f=$(fecha_remota "$mes")
[ "${f:0:7}" = "$(date -u +%Y-%m)" ] || subir "$CIFRADA" "$mes"

rm -f "$CIFRADA"
