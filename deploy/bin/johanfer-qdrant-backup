#!/bin/bash
# Copia de seguridad de la base vectorial (Qdrant).
#
# Instalar en /usr/local/sbin/johanfer-qdrant-backup (root, 0700) y activarlo
# con johanfer-qdrant-backup.timer. Ver deploy/systemd/.
#
# POR QUÉ EXISTE. Hasta septiembre de 2026 solo se respaldaba database.db, y
# era defendible: los vectores se regeneraban con `manage.py qdrant_backfill`
# a partir de las noticias. Con la ventana de duplicados en un año eso dejó de
# ser cierto: las noticias se purgan a los 15 días y sus vectores siguen
# vivos, así que **los vectores antiguos ya no se pueden regenerar desde
# ninguna parte**. Si se pierde el storage, se pierde la capacidad de
# reconocer republicaciones hasta volver a acumular un año de historial.
#
# POR QUÉ UNA VEZ AL DÍA Y NO CADA SEIS HORAS COMO LA BASE. Justo la parte
# irrecuperable es la que no cambia: los vectores viejos. Los del último
# cuarto de hora sí se pueden regenerar con `qdrant_backfill`, porque sus
# noticias siguen en la base. Y el snapshot pesa ~59 MB comprimido (los
# vectores apenas se comprimen): cuatro veces al día multiplicaría la subida
# sin comprar nada.
#
# Se usa la API de snapshots y no un `cp` del storage porque Qdrant está
# escribiendo: copiar los ficheros en caliente daría una copia inconsistente.

#
# Un solo archivo por copia (ver johanfer-backup-lib), en 3 huecos que rotan
# por días: `qdrant/qdrant-0..2`. Con tres basta: la más reciente ya contiene
# todos los vectores anteriores, y las otras dos están por si la última sale
# dañada. Son ~180 MB en el remoto.
set -Eeuo pipefail
umask 077
. /usr/local/sbin/johanfer-backup-lib

QDRANT_URL=${QDRANT_URL:-http://127.0.0.1:6333}
COLLECTION=${QDRANT_COLLECTION:-news_embeddings_gemini001_d768_v1}
# tmpfs (ver deploy/fstab-tmpfs y deploy/qdrant.service).
SNAPSHOT_DIR=/var/lib/qdrant/snapshots
CIFRADA="$WORK_DIR/qdrant.snapshot.zst.gpg"

# --- Crear el snapshot -------------------------------------------------------
respuesta=$(curl -sS -f -X POST   "$QDRANT_URL/collections/$COLLECTION/snapshots?wait=true"   -H 'Content-Type: application/json')

nombre=$(printf '%s' "$respuesta" | python3 -c   'import json,sys; print(json.load(sys.stdin)["result"]["name"])')

if [ -z "$nombre" ]; then
  echo "No se pudo crear el snapshot de Qdrant" >&2
  exit 1
fi

origen="$SNAPSHOT_DIR/$COLLECTION/$nombre"

# Borrar el snapshot del lado de Qdrant pase lo que pase: ocupa lo mismo que
# la colección entera (ahora en RAM, que es peor sitio para dejarlo olvidado).
limpiar() {
  curl -sS -X DELETE     "$QDRANT_URL/collections/$COLLECTION/snapshots/$nombre?wait=true" >/dev/null || true
  rm -f "$CIFRADA"
  terminar_gpg
}
trap limpiar EXIT

if [ ! -f "$origen" ]; then
  echo "El snapshot $nombre no aparece en $origen" >&2
  exit 1
fi

# Se cifra directamente desde el snapshot, sin copiarlo antes: los dos viven
# en RAM y una copia más serían 78 MB de memoria a las tres de la mañana.
NIVEL_ZSTD=6 cifrar "$origen" "$CIFRADA"
subir "$CIFRADA" "qdrant/qdrant-$(( DIA % 3 )).snapshot.zst.gpg"
echo "Copia de Qdrant completada: $nombre"
