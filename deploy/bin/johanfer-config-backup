#!/bin/bash
# Copia semanal de lo que no está en el repo ni en los otros dos backups.
# Instalar en /usr/local/sbin/johanfer-config-backup (ver deploy/systemd/).
#
# Está pensada para reinstalar en limpio, no para clonar la tarjeta: el código
# y la configuración versionada salen del repo, la base y Qdrant de sus propios
# backups, y esto aporta el resto (secretos, ajustes de la máquina y portadas).
# Con un volcado de los paquetes y del crontab, para no olvidar nada al montar
# la máquina nueva.
#
# Un solo archivo por copia (ver johanfer-backup-lib), en 4 huecos que rotan
# por semanas: `config/config-0..3`. Pesa ~11 MB, casi todo portadas
# (media/), que no siempre se pueden volver a bajar: el RSS de Goodreads no
# trae los libros antiguos.
set -Eeuo pipefail
umask 077
. /usr/local/sbin/johanfer-backup-lib
trap terminar_gpg EXIT

ESTADO="$WORK_DIR/config"
ARCHIVO="$WORK_DIR/config.tar"
CIFRADA="$WORK_DIR/config.tar.zst.gpg"

RUTAS=(
  /home/johan/My_Bookshelf/.env
  /home/johan/My_Bookshelf/media
  /home/johan/ssl
  /home/johan/.ssh/authorized_keys
  /home/johan/.cloudflare_api_key
  /home/johan/actualizar_cloudflare.sh
  /home/johan/wifi_watchdog.sh
  /home/johan/deploy.sh
  /etc/johanfer-backup.env
  /etc/nginx
  /etc/fail2ban
  /etc/ufw
  /etc/letsencrypt
  /etc/systemd/system
  /etc/systemd/journald.conf.d
  /etc/logrotate.d
  /etc/sysctl.d
  /etc/modprobe.d
  /etc/default/zramswap
  /etc/sudoers.d
  /etc/NetworkManager/system-connections
  /etc/hostname
  /etc/hosts
  /etc/fstab
  /usr/local/sbin
  /boot/firmware/config.txt
  /boot/firmware/cmdline.txt
)

# Volcados de estado que no son ficheros: sirven de lista de comprobación.
rm -rf "$ESTADO"; install -d -m 700 "$ESTADO"
crontab -l -u johan > "$ESTADO/crontab-johan.txt" 2>/dev/null || true
apt-mark showmanual > "$ESTADO/paquetes-manuales.txt"
dpkg --get-selections > "$ESTADO/dpkg-selections.txt"
systemctl list-unit-files --state=enabled --no-legend --no-pager > "$ESTADO/unidades-habilitadas.txt"
ufw status numbered > "$ESTADO/ufw-status.txt" 2>&1 || true
/home/johan/My_Bookshelf/env/bin/pip freeze > "$ESTADO/pip-freeze.txt" 2>/dev/null || true
cp /etc/os-release "$ESTADO/os-release"
uname -a > "$ESTADO/uname.txt"

# Solo las rutas que existen: una que ya no existe no es un fallo. Van
# relativas a / para que el archivo se pueda extraer en cualquier sitio.
existentes=()
for ruta in "${RUTAS[@]}" "$ESTADO"; do
  [ -e "$ruta" ] && existentes+=("${ruta#/}") || echo "No existe, se omite: $ruta"
done

tar -C / -cf "$ARCHIVO" "${existentes[@]}"
NIVEL_ZSTD=10 cifrar "$ARCHIVO" "$CIFRADA"
rm -rf "$ARCHIVO" "$ESTADO"
subir "$CIFRADA" "config/config-$(( SEMANA % 4 )).tar.zst.gpg"
rm -f "$CIFRADA"
