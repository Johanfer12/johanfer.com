# Instalar en /etc/systemd/system/ junto con johanfer-watching.timer (ver
# deploy/RECREAR-SERVIDOR.md, §2.8). Sustituye a la línea de django-crontab.
#
# Sin Restart=: la tarea ya reintenta los cortes de red (2 y 10 min) y repetir
# la pasada entera volvería a pedir /sync/all-items a Simkl. El plazo de 30 min
# cubre esos reintentos (~12 min en el peor caso).
[Unit]
Description=Sincronización de series y películas (Simkl) de johanfer.com
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=johan
Group=johan
WorkingDirectory=/home/johan/My_Bookshelf
ExecStart=/home/johan/My_Bookshelf/env/bin/python manage.py update_watching
# El mismo log que tenía el cron (rotado por /etc/logrotate.d/bookshelf-cron) y
# que también usa el botón de actualizar del feed: así sigue todo en un sitio.
StandardOutput=append:/home/johan/log_cron_bookshelf.txt
StandardError=append:/home/johan/log_cron_bookshelf.txt
Environment=PYTHONUNBUFFERED=1 LANG=C.UTF-8
# Por debajo de gunicorn, que es quien atiende a las visitas.
Nice=10
TimeoutStartSec=30min
