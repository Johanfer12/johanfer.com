# Copia de seguridad de la base SQLite. Instalar en /etc/systemd/system/.
# El script va en /usr/local/sbin/johanfer-db-backup (ver deploy/bin/).
[Unit]
Description=Backup cifrado de la base SQLite de johanfer.com
After=network-online.target
Wants=network-online.target
# Reintentos: ver johanfer-qdrant-backup.service.
StartLimitIntervalSec=2h
StartLimitBurst=4

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/johanfer-db-backup
UMask=0077
Nice=10
IOSchedulingClass=idle
Restart=on-failure
RestartSec=15min
